%  7. 图表与文献标题的中文化
% ------------------------------------------------------------
\renewcommand\tablename{表}
\renewcommand\figurename{图}
\renewcommand\refname{\sanhao\hei{参考文献}}
% 图表清单标题留空（由 \section* 标题代替）
\renewcommand{\listfigurename}{~}
\renewcommand{\listtablename}{~}

% 图片/表格命名辅助命令
\newcommand{\figcaption}{\def\@captype{figure}\caption}
\newcommand{\tabcaption}{\def\@captype{table}\caption}

% 参考文献标注显示在右上角（用法：\upcite{key}）
% 注：\upcite 由 gbt7714 样式内置，此处不定义，
%     见下方“10. 参考文献方案”末尾的条件定义（兜底用）

% ------------------------------------------------------------
%  8. 作者与版本信息（修改请在本节进行）
% ------------------------------------------------------------
% 定义统一的作者和版本号
\newcommand{\SoftwareName}{软件名称}
\newcommand{\Version}{V1.0}

% 定义纯作者列表（不含“作者：”，用换行分隔）
\newcommand{\PureAuthors}{%
	作者1 \\
	作者2 \\
	作者3%
}

% 带前缀的完整作者显示（“作者：”不参与替换）
\newcommand{\BasicAuthor}{作者：\\\PureAuthors}

% 修订记录的作者（仅处理纯作者列表，换行转逗号）
\usepackage{xstring}
\newcommand{\RevisedAuthor}{%
	\StrSubstitute{\PureAuthors}{\\}{, }% 只替换作者间的换行
}

% ------------------------------------------------------------
%  9. 页眉页脚
% ------------------------------------------------------------
%获得总页数
\usepackage{lastpage}

% 设置页眉样式（公共定义避免重复）
\newcommand{\CommonHeader}{
	\fancyhead[L]{\wuhao{\SoftwareName~~~\Version}}%
	\fancyhead[R]{Page \thepage\ of \pageref{LastPage}}%
}
\fancypagestyle{plain}{
	\fancyhead{}
	\CommonHeader
}
\pagestyle{fancy}
\fancyhead{}
\CommonHeader

\setlength{\headheight}{14.5pt} % 消除 fancyhdr \headheight too small 警告

% ------------------------------------------------------------
%  10. 参考文献方案（二选一，默认启用方案 A）
% ------------------------------------------------------------
% 用于正文自动判断当前启用的是哪种方案（\ifcsdef{printbibliography}）
\usepackage{etoolbox}

% ---- 方案 A（默认，推荐）：biblatex + biber + gbt7714 样式 ----
% GB/T 7714-2015 顺序编码制（按正文引用顺序编号）
\usepackage[backend=biber, style=gb7714-2015, sorting=none]{biblatex}
\addbibresource{refs.bib}

% ---- 方案 B（备选）：bibtex + gbt7714 宏包（natbib 接口）----
% 需要 TeX Live 自带的 gbt7714 宏包（含 gbt7714-numerical.bst）。
% 如需切换：注释掉上面方案 A 的两行，并取消下面一行的注释。
% \bibliographystyle 与 \bibliography 由 main.tex 参考文献部分统一处理。
% \usepackage[sort&compress]{gbt7714}

% \upcite 兜底定义：仅当所选参考文献方案未内置 \upcite 时才定义
% （gbt7714 的 biblatex 与 natbib 接口均已内置，一般不会走到这里）
\ifdef{\upcite}{}{\newcommand{\upcite}[1]{\textsuperscript{\cite{#1}}}}

