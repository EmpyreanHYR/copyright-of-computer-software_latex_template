% ============================================================
%  softcopyright.sty —— 计算机软件著作权说明书样式配置
%
%  本文件集中了模板的全部导言区配置（宏包、字体、字号、版面、
%  标题格式、页眉、参考文献等），由 main.tex 通过
%  \usepackage{softcopyright} 加载。
%
%  修改模板样式时请优先修改本文件；main.tex 只保留文档结构与内容。
%
%  主要可配置项：
%    - 软件名称 / 版本号 / 作者：见“8. 作者与版本信息”一节
%    - 参考文献方案（biblatex 或 bibtex）：见“10. 参考文献方案”一节
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{softcopyright}[2025/07/01 v1.0 Software copyright manual style]

\makeatletter

% ------------------------------------------------------------
%  1. 基础宏包
% ------------------------------------------------------------
\usepackage[]{graphicx}
\usepackage[]{xcolor}

% 图片最大宽度控制（自动缩放到行宽以内）
\def\maxwidth{ %
	\ifdim\Gin@nat@width>\linewidth
	\linewidth
	\else
	\Gin@nat@width
	\fi
}

\usepackage{framed}
% 带背景色的代码/段落框（knitr 输出用）
\newenvironment{kframe}{%
	\def\at@end@of@kframe{}%
	\ifinner\ifhmode%
	\def\at@end@of@kframe{\end{minipage}}%
\begin{minipage}{\columnwidth}%
	\fi\fi%
	\def\FrameCommand##1{\hskip\@totalleftmargin \hskip-\fboxsep
		\colorbox{shadecolor}{##1}\hskip-\fboxsep
		% There is no \\@totalrightmargin, so:
		\hskip-\linewidth \hskip-\@totalleftmargin \hskip\columnwidth}%
	\MakeFramed {\advance\hsize-\width
		\@totalleftmargin\z@ \linewidth\hsize
		\@setminipage}}%
{\par\unskip\endMakeFramed%
	\at@end@of@kframe}

\definecolor{shadecolor}{rgb}{.97, .97, .97}
\definecolor{messagecolor}{rgb}{0, 0, 0}
\definecolor{warningcolor}{rgb}{1, 0, 1}
\definecolor{errorcolor}{rgb}{1, 0, 0}
\newenvironment{knitrout}{}{} % an empty environment to be redefined in TeX

\usepackage{alltt}

% ------------------------------------------------------------
%  2. 字体设置
%     ctex 文档类已通过 fontset=auto 自动配置中文字体
%     （Windows -> 宋体/黑体；macOS -> Songti SC；Linux -> Fandol），
%     无需手动加载 xeCJK，也无需 \setCJKmonofont 硬编码
%     （原 \setCJKmonofont{SimSun} 已删除：CJK 等宽字体同样由
%     ctex 按平台接管，硬编码 SimSun 在非 Windows 上会编译失败）。
%     内置中文命令：\songti \heiti \kaishu \fangsong
%     本节只处理英文字体，并为非 Windows 平台提供回退。
% ------------------------------------------------------------
\usepackage{fontspec}

% 英文主字体：按平台可用性自动回退
%   Windows / macOS -> Times New Roman
%   Linux           -> Liberation Serif / TeX Gyre Termes（TeX Live 自带）
\IfFontExistsTF{Times New Roman}{%
	\setmainfont{Times New Roman}}%
{\IfFontExistsTF{Times}{%
	\setmainfont{Times}}%
{\IfFontExistsTF{Liberation Serif}{%
	\setmainfont{Liberation Serif}}%
{\IfFontExistsTF{TeX Gyre Termes}{%
	\setmainfont{TeX Gyre Termes}}{}}}}

% 英文等宽字体：按平台可用性自动回退（首选 Consolas）
%   Windows -> Consolas
%   macOS   -> Menlo / Courier New
%   Linux   -> DejaVu Sans Mono / Liberation Mono
% 若全部缺失则保持 fontspec 默认等宽字体，保证任何平台都能编译
\IfFontExistsTF{Consolas}{%
	\setmonofont{Consolas}}%
{\IfFontExistsTF{Menlo}{%
	\setmonofont{Menlo}}%
{\IfFontExistsTF{Courier New}{%
	\setmonofont{Courier New}}%
{\IfFontExistsTF{DejaVu Sans Mono}{%
	\setmonofont{DejaVu Sans Mono}}%
{\IfFontExistsTF{Liberation Mono}{%
	\setmonofont{Liberation Mono}}{}}}}}

