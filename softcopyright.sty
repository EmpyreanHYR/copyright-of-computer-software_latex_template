% ------------------------------------------------------------
%  5. 章节标题、目录与行距
% ------------------------------------------------------------
\usepackage{titlesec}
\usepackage{titletoc}
\usepackage{setspace}

% 编号章节（正文 \section）自动从新页开始
\titleformat{\section}{\newpage\hei\sanhao}{\thesection}{1em}{}
% 无编号章节（\section*）不加 \newpage，避免目录/图表清单出现空白页
\titleformat{name=\section,numberless}{\hei\sanhao}{}{1em}{}
\titleformat{\subsection}{\hei\sihao}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\hei\xiaosihao}{\thesubsubsection}{1em}{}

% 行间距（1.5 倍；setspace 对脚注/浮动体智能豁免）
\onehalfspacing

