# 强制脚本换行风格：shell 脚本必须 LF（否则 shebang 失效），批处理用 CRLF
*.sh        text eol=lf
*.command   text eol=lf
*.bat       text eol=crlf
*.tex       text eol=lf
*.sty       text eol=lf
*.bib       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
.latexmkrc  text eol=lf

# 归档导出时忽略开发与 CI 配置
.github        export-ignore
.gitattributes export-ignore
