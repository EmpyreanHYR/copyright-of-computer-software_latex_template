% ============================================================
%  refs.bib —— 参考文献数据库（示例）
%
%  用法：
%   1. 在正文中引用：\cite{key}（文末编号列表）或 \upcite{key}（右上角上标）
%   2. 未被引用的条目不会出现在参考文献列表中；
%      如需全部列出，可在 main.tex 参考文献部分加一行 \nocite{*}
%   3. 按 GB/T 7714-2015 填写字段（作者用 and 分隔，中文自动转顿号）
%
%  请把下列示例条目替换为实际引用的文献。
% ============================================================

% 图书
@book{example:book,
  author    = {张三 and 李四},
  title     = {软件工程导论},
  publisher = {清华大学出版社},
  address   = {北京},
  year      = {2020},
  edition   = {3}
}

% 期刊论文
@article{example:article,
  author  = {王五 and 赵六},
  title   = {基于深度学习的图像识别方法研究},
  journal = {计算机学报},
  year    = {2022},
  volume  = {45},
  number  = {3},
  pages   = {500--512}
}

% 网络资源
@online{example:online,
  author  = {国家版权局},
  title   = {计算机软件著作权登记办法},
  url     = {https://www.ncac.gov.cn/},
  urldate = {2025-06-29}
}
